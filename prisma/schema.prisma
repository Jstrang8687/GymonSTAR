generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  isAdmin       Boolean   @default(false)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  profile       UserProfile?
  monsters      MonSTAR[]
  programs      TrainingProgram[]
  workoutLogs   WorkoutLog[]
  templates     WorkoutTemplate[]
  authTokens    AuthToken[]
}

model Coach {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  title       String
  focus       String
  description String
  icon        String

  profiles    UserProfile[]
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId       String?
  coach         Coach?    @relation(fields: [coachId], references: [id])
  trainerLevel  Int       @default(1)
  trainerXp     Int       @default(0)
  loginStreak   Int       @default(0)
  lastLoginDate String?
  onboarded     Boolean   @default(false)
}

enum MuscleType {
  CHEST
  SIDE_DELTS
  FRONT_DELTS
  REAR_DELTS
  ROTATOR_CUFF
  LATS
  UPPER_TRAPS
  LOWER_TRAPS
  RHOMBOIDS
  LOWER_BACK
  BICEPS
  TRICEPS
  FOREARM_FLEXORS
  FOREARM_EXTENSORS
  GRIP
  UPPER_ABS
  LOWER_ABS
  OBLIQUES
  DEEP_CORE
  SERRATUS
  NECK_FLEXORS
  NECK_EXTENSORS
  OUTER_QUADS
  INNER_QUADS
  HAMSTRINGS
  GLUTE_MAX
  GLUTE_MED
  ADDUCTORS
  ABDUCTORS
  HIP_FLEXORS
  CALVES_GASTROC
  CALVES_SOLEUS
  TIBIALIS
  CARDIO
}

model MonSTAR {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleType   MuscleType
  nickname     String?
  level        Int        @default(1)
  xp           Int        @default(0)
  strengthXp   Int        @default(0)
  enduranceXp  Int        @default(0)
  caughtAt     DateTime   @default(now())

  @@unique([userId, muscleType])
}

enum ProgramType {
  UPPER_LOWER
  BRO_SPLIT
  PUSH_PULL_LEGS
  CUSTOM
}

model TrainingProgram {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ProgramType
  schedule  String
  startDate DateTime    @default(now())
  active    Boolean     @default(true)
}

model WorkoutLog {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String
  durationMinutes Int        @default(0)
  exercises       String
  xpAwarded       Int        @default(0)
  caughtNewMonster Boolean   @default(false)
  muscleTypes     String
  // JSON map of muscleType -> { strengthXp, enduranceXp } for exactly the
  // monSTARs that received XP from this log, so deleting the log later can
  // reverse it precisely. Null on logs created before this field existed.
  xpBreakdown     String?
  createdAt       DateTime   @default(now())

  videoFilename   String?
  videoMimeType   String?
  videoVerifiedAt DateTime?
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// One-time links emailed to a user (verify their email, reset their
// password). Only a SHA-256 hash of the token is ever stored -- the raw
// token exists only in the emailed URL, never in the database, same
// principle as never storing a plaintext password.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  type      AuthTokenType
  expiresAt DateTime
  createdAt DateTime      @default(now())
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // JSON MuscleType[] and JSON TemplateExercise[] (name/category/muscleType only --
  // no sets/reps/weight, since a template is the skeleton you fill in each time).
  muscleTypes String
  exercises   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Exercises the static library (src/data/exercises.json) doesn't have, added
// automatically the first time someone logs a workout with a name it doesn't
// recognize and tags which muscle group it trains. Shared across all users
// (like the static library) so the searchable set grows from real usage
// instead of everyone hitting the same gap over and over.
model CustomExercise {
  id             String     @id @default(cuid())
  name           String
  // Same normalization as normalizeExerciseQuery() in exerciseLibrary.ts --
  // enforced unique here so two people logging "Push Up" and "push-up" on
  // the same untracked exercise can't both create separate entries.
  normalizedName String     @unique
  muscleType     MuscleType
  category       String
  createdByEmail String
  createdAt      DateTime   @default(now())
}

// A real-world location, claimed by whoever checks in there first (a
// one-time GPS grab, not live tracking -- see GymChallenge for what
// "claimed" actually means). championMuscleType is fixed to whichever of
// the champion's monSTARs was their strongest at claim/defense time -- that's
// what any challenger has to already own a monster of to fight for the gym.
model Gym {
  id                 String    @id @default(cuid())
  name               String
  latitude           Float
  longitude          Float
  championUserId     String?
  championMuscleType MuscleType?
  claimedAt          DateTime?
  createdAt          DateTime  @default(now())

  challenges         GymChallenge[]
}

enum GymChallengeStatus {
  OPEN
  RESOLVED
}

// THRONE duels are challenger-vs-champion, gym-gated by check-in -- winning
// hands over the gym. FREEFORM duels are open PvP between any two trainers,
// found by search, with no gym or location involved at all.
enum GymChallengeKind {
  THRONE
  FREEFORM
}

// A live duel window over one gym. Score = each side's MonSTAR.xp for
// muscleType at the moment the challenge opened, plus whatever xpBreakdown
// credit either of them earns for that exact muscleType from real
// WorkoutLogs during [windowStart, windowEnd] -- computed on read
// (gymDuel.ts), not tracked incrementally. Ties go to the defender.
model GymChallenge {
  id                   String             @id @default(cuid())
  // Null for FREEFORM duels -- those aren't tied to any location.
  gymId                String?
  gym                  Gym?               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  kind                 GymChallengeKind   @default(THRONE)
  muscleType           MuscleType
  challengerId         String
  defenderId           String
  challengerStartXp    Int
  defenderStartXp      Int
  windowStart          DateTime
  windowEnd            DateTime
  status               GymChallengeStatus @default(OPEN)
  winnerId             String?
  resolvedAt           DateTime?
  createdAt            DateTime           @default(now())
}
